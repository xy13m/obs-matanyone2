// SPDX-License-Identifier: GPL-3.0-or-later
//
// Guided filter passes (He et al.) at half resolution. The guide I is the
// luma of the frame, p is the working-resolution matte. The final
// q = mean_a * I + mean_b happens in matanyone2.effect.
//
//   Pack:  (I, p, I*I, I*p)            from image + matte
//   BoxH / BoxV: separable box blur     of any RGBA16F texture
//   Coeff: (a, b) = (cov/(var+eps), mean_p - a*mean_I)

uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d matte;
uniform float2 texel_size;   // of the texture being blurred
uniform float eps;

sampler_state linear_clamp {
	Filter = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv = v_in.uv;
	return vert_out;
}

float luma(float4 color)
{
	float3 rgb = max(float3(0.0, 0.0, 0.0), color.rgb / max(color.a, 0.00001));
	return dot(rgb, float3(0.2126, 0.7152, 0.0722));
}

float4 PSPack(VertData v_in) : TARGET
{
	float i = luma(image.Sample(linear_clamp, v_in.uv));
	float p = matte.Sample(linear_clamp, v_in.uv).r;
	return float4(i, p, i * i, i * p);
}

// Radius 8: 17 taps. Two passes give the box mean.
float4 box(float2 uv, float2 step)
{
	float4 sum = float4(0.0, 0.0, 0.0, 0.0);
	for (int k = -8; k <= 8; k++) {
		sum += image.Sample(linear_clamp, uv + step * float(k));
	}
	return sum / 17.0;
}

float4 PSBoxH(VertData v_in) : TARGET
{
	return box(v_in.uv, float2(texel_size.x, 0.0));
}

float4 PSBoxV(VertData v_in) : TARGET
{
	return box(v_in.uv, float2(0.0, texel_size.y));
}

float4 PSCoeff(VertData v_in) : TARGET
{
	float4 m = image.Sample(linear_clamp, v_in.uv);   // mean_I, mean_p, corr_I, corr_Ip
	float var_i = m.z - m.x * m.x;
	float cov_ip = m.w - m.x * m.y;
	float a = cov_ip / (var_i + eps);
	float b = m.y - a * m.x;
	return float4(a, b, 0.0, 1.0);
}

technique Pack
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSPack(v_in);
	}
}

technique BoxH
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSBoxH(v_in);
	}
}

technique BoxV
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSBoxV(v_in);
	}
}

technique Coeff
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSCoeff(v_in);
	}
}
